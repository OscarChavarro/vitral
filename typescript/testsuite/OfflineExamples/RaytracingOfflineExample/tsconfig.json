{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ES2022",
        "moduleResolution": "bundler",
        "lib": ["ES2022", "DOM"],
        "rootDir": "src",
        "outDir": "dist",
        "strict": true,
        "noImplicitOverride": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "noFallthroughCasesInSwitch": true,
        "noEmitOnError": true,
        "sourceMap": true,
        "types": ["node"]
    },
    "references": [{ "path": "../../../base" }, { "path": "../../../fs" }],
    "files": ["src/RaytracerSimple.ts", "src/RaytracerTileWorker.ts"]
}
