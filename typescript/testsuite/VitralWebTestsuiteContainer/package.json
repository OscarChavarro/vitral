{
  "name": "vitral-web-testsuite-container",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "sync:etc": "./scripts/sync-etc.sh",
    "build:webgl": "npm run --prefix ../.. --workspace @vitral/webgl build",
    "prestart": "npm run build:webgl && npm run sync:etc",
    "start": "ng serve",
    "prebuild": "npm run build:webgl && npm run sync:etc",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run build:webgl",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@vitral/base": "file:../../base",
    "@vitral/webgl": "file:../../webgl",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.24",
    "@angular/cli": "^21.2.24",
    "@angular/compiler-cli": "^21.2.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
