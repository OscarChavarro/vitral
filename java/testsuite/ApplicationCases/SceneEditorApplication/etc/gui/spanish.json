  "commands": [
    {
      "id": "IDC_FILE_SALIR",
      "name": "Salir",
      "brief": "Termina los procesos de edicion y simulacion AQUYNZA",
      "help": [
        "La opcion salir termina los procesos de edicion y/o simulacion y ",
        "da por concluida la ejecucion de la aplicacion.  Este comando ",
        "solicita confirmacion si la sesion de edicion actual no ha sido ",
        "guardada.  Para terminar la sesion de edicion y dejar corriendo ",
        "una simulacion en modo batch (procesamiento por lotes), vea el ",
        "comando <eat>."
      ]
    },
    {
      "id": "IDC_FILE_NEW",
      "name": "Nuevo",
      "brief": "Cierra la sesion actual (si la hay) y empieza una nueva",
      "help": [
        "El comando solicita confirmacion si la sesion actual no ha sido ",
        "grabada. En la version profesional de Nukak puede especificarse ",
        "la edicion distribuida."
      ]
    },
    {
      "id": "IDC_FILE_LOAD",
      "name": "Leer",
      "brief": "Lee un entorno AQUYNZA previamente creado",
      "help": [
        "<Aun no disponible>"
      ]
    },
    {
      "id": "IDC_FILE_SAVE",
      "name": "Grabar",
      "brief": "Graba el entorno actual AQUYNZA",
      "help": [
        "<Aun no disponible>"
      ]
    },
