            ]
          },
          {
            "type": "item",
            "modifiers": [
              "SEPARATOR"
            ]
          },
          {
            "type": "item",
            "name": "&Salir",
            "modifiers": [
              "IDC_FILE_QUIT"
            ]
          }
        ]
      },
