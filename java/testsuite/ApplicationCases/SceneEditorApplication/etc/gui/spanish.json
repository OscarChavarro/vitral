        "children": [
          {
            "type": "item",
            "name": "&Nuevo...\tCtrl+N",
            "modifiers": [
              "IDC_FILE_NEW"
            ]
          },
          {
            "type": "item",
            "name": "&Leer...\tCtrl+L",
            "modifiers": [
              "IDC_FILE_LOAD"
            ]
          },
          {
            "type": "item",
            "name": "&Grabar...\tCtrl+G",
            "modifiers": [
