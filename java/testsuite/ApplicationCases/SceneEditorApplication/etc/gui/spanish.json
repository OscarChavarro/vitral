          {
            "type": "item",
            "modifiers": [
              "SEPARATOR"
            ]
          },
          {
            "type": "item",
            "name": "&Cortar\tCtrl+X",
            "modifiers": [
              "IDC_EDIT_CUT",
              "GRAYED"
            ]
          },
          {
            "type": "item",
            "name": "&Copiar\tCtrl+C",
            "modifiers": [
              "IDC_EDIT_COPY",
              "GRAYED"
            ]
          },
          {
            "type": "item",
            "name": "&Pegar\tCtrl+V",
            "modifiers": [
              "IDC_EDIT_PASTE",
              "GRAYED"
            ]
          }
        ]
