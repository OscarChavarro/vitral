@echo off
rem Run from the DOS directory after DOS.BAT has built PMSW286 and CRT.
if exist SRC\MAIN\V\KERNEL\286\LOADER\LOADER.EXE del SRC\MAIN\V\KERNEL\286\LOADER\LOADER.EXE
echo -c -ml -2 -f87 -O1 > BOOT.RSP
echo -IC:\TURBOC\INCLUDE >> BOOT.RSP
echo -ISRC\MAIN\V\KERNEL\286 >> BOOT.RSP
echo -oBUILDTC\PBOOT286.OBJ >> BOOT.RSP
echo SRC\MAIN\V\KERNEL\286\LOADER\PBOOT286.CPP >> BOOT.RSP
tcc @BOOT.RSP > BOOT.LOG
if errorlevel 1 goto error
echo BUILDTC\PMSW286.OBJ+BUILDTC\PBOOT286.OBJ+ > BOOTOBJ.RSP
echo SRC\MAIN\V\KERNEL\286\VLIBC\BUILD\HELPERS.OBJ+ >> BOOTOBJ.RSP
echo SRC\MAIN\V\KERNEL\286\VLIBC\BUILD\FPU.OBJ >> BOOTOBJ.RSP
tlink /n /c /s @BOOTOBJ.RSP,SRC\MAIN\V\KERNEL\286\LOADER\LOADER.EXE,SRC\MAIN\V\KERNEL\286\LOADER\LOADER.MAP > BOOTLINK.LOG
if errorlevel 1 goto error
echo 286 loader built successfully.
goto end
:error
type BOOT.LOG
type BOOTLINK.LOG
echo 286 loader build failed.
:end
