# Bicubic patches: "patch <uniform|grid|adaptive|tree|smooth> <uSteps> <vSteps>
# [flatness <value>]" opens a block of 16 "control <x> <y> <z>" lines, row by
# row (u = 0, 1/3, 2/3, 1, each for v = 0..1), closed by "end". The patch is
# the open surface of those flat triangles: grid and uniform cut it into
# uSteps x vSteps cells, adaptive and tree halve it up to uSteps and vSteps
# levels until flatter than the flatness, smooth interpolates the normals.
# As in PovRay, adaptive pieces of different depths leave cracks between them
# and smooth can reverse corner normals.
# Patches are not solids, so they cannot be csg operands.
viewport 640 480
eye 5.5 -7 4.2
up 0 0 1
lookat 0 0 0.8
fov 42
background 0.08 0.09 0.12
light 0.3 0.3 0.3 ambient
light 0.85 0.8 0.75 point 5 -6 8
light 0.3 0.35 0.45 point -6 -2 5
surface 0.65 0.66 0.7 0.2 0.8 0.2 20 0 0 1
sphere 0 0 -1001 1000
# Dome of four quadrant patches, a Bezier circle profile of radius 1.4.
surface 0.8 0.55 0.25 0.2 0.8 0.6 60 0.1 0 1
patch grid 10 10
control -1.600000 0.000000 1.400000
control -1.600000 0.000000 1.400000
control -1.600000 0.000000 1.400000
control -1.600000 0.000000 1.400000
control -0.826780 0.000000 1.400000
control -0.826780 0.427049 1.400000
control -1.172951 0.773220 1.400000
control -1.600000 0.773220 1.400000
control -0.200000 0.000000 0.773220
control -0.200000 0.773220 0.773220
control -0.826780 1.400000 0.773220
control -1.600000 1.400000 0.773220
control -0.200000 0.000000 0.000000
control -0.200000 0.773220 0.000000
control -0.826780 1.400000 0.000000
control -1.600000 1.400000 0.000000
end
patch grid 10 10
control -1.600000 0.000000 1.400000
control -1.600000 0.000000 1.400000
control -1.600000 0.000000 1.400000
control -1.600000 0.000000 1.400000
control -1.600000 0.773220 1.400000
control -2.027049 0.773220 1.400000
control -2.373220 0.427049 1.400000
control -2.373220 0.000000 1.400000
control -1.600000 1.400000 0.773220
control -2.373220 1.400000 0.773220
control -3.000000 0.773220 0.773220
control -3.000000 0.000000 0.773220
control -1.600000 1.400000 0.000000
control -2.373220 1.400000 0.000000
control -3.000000 0.773220 0.000000
control -3.000000 0.000000 0.000000
end
patch grid 10 10
control -1.600000 0.000000 1.400000
control -1.600000 0.000000 1.400000
control -1.600000 0.000000 1.400000
control -1.600000 0.000000 1.400000
control -2.373220 0.000000 1.400000
control -2.373220 -0.427049 1.400000
control -2.027049 -0.773220 1.400000
control -1.600000 -0.773220 1.400000
control -3.000000 0.000000 0.773220
control -3.000000 -0.773220 0.773220
control -2.373220 -1.400000 0.773220
control -1.600000 -1.400000 0.773220
control -3.000000 0.000000 0.000000
control -3.000000 -0.773220 0.000000
control -2.373220 -1.400000 0.000000
control -1.600000 -1.400000 0.000000
end
patch grid 10 10
control -1.600000 -0.000000 1.400000
control -1.600000 -0.000000 1.400000
control -1.600000 -0.000000 1.400000
control -1.600000 -0.000000 1.400000
control -1.600000 -0.773220 1.400000
control -1.172951 -0.773220 1.400000
control -0.826780 -0.427049 1.400000
control -0.826780 -0.000000 1.400000
control -1.600000 -1.400000 0.773220
control -0.826780 -1.400000 0.773220
control -0.200000 -0.773220 0.773220
control -0.200000 -0.000000 0.773220
control -1.600000 -1.400000 0.000000
control -0.826780 -1.400000 0.000000
control -0.200000 -0.773220 0.000000
control -0.200000 -0.000000 0.000000
end
# Waving sheet as a subdivision tree of uniform depth, placed by a transform.
surface 0.3 0.55 0.85 0.2 0.8 0.5 40 0.15 0 1
transform 1 0 0 1.7  0 0 -1 0.2  0 1 0 0.3
patch tree 3 3 flatness 0
control -1.200000 0.000000 0.000000
control -1.200000 0.900000 0.140999
control -1.200000 1.800000 0.175293
control -1.200000 2.700000 0.076928
control -0.400000 0.000000 0.290062
control -0.400000 0.900000 0.150784
control -0.400000 1.800000 -0.102604
control -0.400000 2.700000 -0.278344
control 0.400000 0.000000 -0.103494
control 0.400000 0.900000 -0.371047
control 0.400000 1.800000 -0.357799
control 0.400000 2.700000 -0.073776
control 1.200000 0.000000 -0.479109
control 1.200000 0.900000 -0.144598
control 1.200000 1.800000 0.299343
control 1.200000 2.700000 0.516746
end
