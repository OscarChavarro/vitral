# Height fields: "heightfield <file> [water <level>]" reads an altimetry file
# (see terrain.alt), resolved from this file's directory. Its local frame has
# the grid on x and z and the heights on y; the solid is the part of the grid
# box below the surface, and "water" raises the box floor. A preceding
# "transform" places it like any other primitive.
viewport 640 480
eye 5.5 -6.5 4.5
up 0 0 1
lookat 0 0 0.3
fov 45
background 0.55 0.7 0.9
light 0.3 0.3 0.3 ambient
light 0.9 0.85 0.75 directional -0.5 0.4 -0.8
light 0.25 0.3 0.35 point -5 -4 6
# Terrain over 6.4 x 6.4 units, z up, heights scaled by 0.15.
surface 0.55 0.6 0.35 0.2 0.8 0.1 10 0 0 1
transform 0.1 0 0 -3.2  0 0 -0.1 3.2  0 0.15 0 0
heightfield terrain.alt water 0.6
# Lake surface at the water line.
surface 0.2 0.35 0.6 0.2 0.6 0.6 80 0.3 0 1
box -3.2 -3.2 0 3.2 3.2 0.27
