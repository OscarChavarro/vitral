# Polynomial implicit surfaces F(x,y,z) < 0.
# "poly <order> [sturm]" opens a block of "term <coefficient> <x> <y> <z>"
# lines (coefficient of x^x y^y z^z) closed by "end". "transform" gives the
# 3x4 affine placement (rows of the matrix) of the next primitive or csg block.
viewport 640 480
eye 0 -9 4.5
up 0 0 1
lookat 0 0 0.4
fov 45
background 0.08 0.1 0.16
light 0.3 0.3 0.3 ambient
light 0.8 0.8 0.8 point 5 -6 8
light 0.35 0.35 0.4 point -6 -2 5
surface 0.7 0.72 0.75 0.2 0.8 0.2 20 0 0 1
sphere 0 0 -1001 1000
# Quartic torus of radii 1.2 and 0.4 around z, tilted 30 degrees about x:
# (|p|^2 + 1.28)^2 - 5.76 (x^2 + y^2)
surface 0.85 0.45 0.15 0.2 0.8 0.6 40 0.05 0 1
transform 1 0 0 -1.7  0 0.8660254 -0.5 0  0 0.5 0.8660254 0.5
poly 4 sturm
term 1 4 0 0
term 1 0 4 0
term 1 0 0 4
term 2 2 2 0
term 2 2 0 2
term 2 0 2 2
term -3.2 2 0 0
term -3.2 0 2 0
term 2.56 0 0 2
term 1.6384 0 0 0
end
# Cubic monkey saddle z = x^3 - 3 x y^2, solid below it, cut by a sphere.
surface 0.2 0.5 0.85 0.2 0.8 0.6 40 0.05 0 1
transform 1 0 0 1.7  0 1 0 0  0 0 1 0.2
csg intersection
poly 3
term 1 0 0 1
term -1 3 0 0
term 3 1 2 0
end
sphere 0 0 0 1.1
end
