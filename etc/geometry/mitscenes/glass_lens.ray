# Refraction example after the Vulkan WhittedRaytracer scene: a ground plane,
# an opaque sphere and a glass sphere (index 1.5) between it and the camera,
# through which the opaque sphere is seen inverted and deformed, as by a lens.
viewport 640 480
eye 9 -3.2 2.6
up 0 0 1
lookat 1.2 0 1.1
fov 40
background 0.08 0.12 0.2
# Ground plane
surface 0.8 0.8 0.8 0.1 0.8 0.3 8 0 0 1
halfspace 0 0 1 0
# Opaque sphere (sphere.mtl)
surface 0.982 0.858 0.401 0.1 0.9 1.0 16 0 0 1
sphere 0 0 1 1
# Glass sphere (sphere_glass.mtl: Kd 0.06, Ks 1, Ns 192, Ni 1.5)
surface 1 1 1 0.02 0.06 1.0 192 0.1 0.9 1.5
sphere 2.5 0 1.5 1
light 0.3 0.3 0.3 ambient
light 0.9 0.9 0.9 point 4 -6 8
