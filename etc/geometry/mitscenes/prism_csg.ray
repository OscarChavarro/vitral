# Parametric prisms (not converted to boundary representations): a concave
# star prism, a square prism with a spherical bite (Roth CSG difference) and
# a hexagonal prism rounded by a sphere (Roth CSG intersection).
#
# prism x y z height n x1 y1 ... xn yn
#   base polygon of n vertices on the plane z = 0 of the body, placed at
#   (x, y, z), swept height units along +Z

viewport 800 450
eye 1.2 -8.5 5.2
up 0 0 1
lookat 0 0 0.5
fov 38
background 0.08 0.12 0.2

surface 0.7 0.72 0.75 0.2 0.8 0.2 20 0 0 1
halfspace 0 0 1 0

surface 0.95 0.75 0.25 0.2 0.8 0.7 60 0.1 0 1
prism -2.3 0 0 0.6 10 0 1 -0.24687 0.339787 -0.951057 0.309017 -0.399444 -0.129787 -0.587785 -0.809017 0 -0.42 0.587785 -0.809017 0.399444 -0.129787 0.951057 0.309017 0.24687 0.339787

surface 0.3 0.5 0.9 0.2 0.8 0.7 60 0.05 0 1
csg difference
prism 0 0 0 1.4 4 -0.9 -0.9 0.9 -0.9 0.9 0.9 -0.9 0.9
sphere 0 0 1.4 0.75
end

surface 0.85 0.3 0.3 0.2 0.8 0.7 60 0.05 0 1
csg intersection
prism 2.3 0 0 1.8 6 0.9 0 0.45 0.779423 -0.45 0.779423 -0.9 0 -0.45 -0.779423 0.45 -0.779423
sphere 2.3 0 0.9 1.05
end

light 0.35 0.35 0.35 ambient
light 0.9 0.9 0.9 point 4 -3 6
light 0.4 0.4 0.4 point -4 -2 4
