#ifndef __ATOMIC__
#define __ATOMIC__
#include <cstddef>
namespace std {
enum memory_order {
    memory_order_relaxed = __ATOMIC_RELAXED,
    memory_order_consume = __ATOMIC_CONSUME,
    memory_order_acquire = __ATOMIC_ACQUIRE,
    memory_order_release = __ATOMIC_RELEASE,
    memory_order_acq_rel = __ATOMIC_ACQ_REL,
    memory_order_seq_cst = __ATOMIC_SEQ_CST
};
template <typename T> class atomic {
public:
    atomic() noexcept = default;
    constexpr atomic(T initial) noexcept : value(initial) {}
    atomic(const atomic &) = delete;
    atomic &operator=(const atomic &) = delete;
    T operator=(T v) noexcept { store(v); return v; }
    operator T() const noexcept { return load(); }
    bool is_lock_free() const noexcept { return true; }
    void store(T v, memory_order order = memory_order_seq_cst) noexcept { __atomic_store_n(&value, v, order); }
    T load(memory_order order = memory_order_seq_cst) const noexcept { return __atomic_load_n(&value, order); }
    T exchange(T v, memory_order order = memory_order_seq_cst) noexcept { return __atomic_exchange_n(&value, v, order); }
    bool compare_exchange_strong(T &expected, T desired, memory_order order = memory_order_seq_cst) noexcept {
        return __atomic_compare_exchange_n(&value, &expected, desired, false, order, __ATOMIC_RELAXED);
    }
    bool compare_exchange_weak(T &expected, T desired, memory_order order = memory_order_seq_cst) noexcept {
        return __atomic_compare_exchange_n(&value, &expected, desired, true, order, __ATOMIC_RELAXED);
    }
    T fetch_add(T v, memory_order order = memory_order_seq_cst) noexcept { return __atomic_fetch_add(&value, v, order); }
    T fetch_sub(T v, memory_order order = memory_order_seq_cst) noexcept { return __atomic_fetch_sub(&value, v, order); }
    T fetch_and(T v, memory_order order = memory_order_seq_cst) noexcept { return __atomic_fetch_and(&value, v, order); }
    T fetch_or(T v, memory_order order = memory_order_seq_cst) noexcept { return __atomic_fetch_or(&value, v, order); }
    T fetch_xor(T v, memory_order order = memory_order_seq_cst) noexcept { return __atomic_fetch_xor(&value, v, order); }
    T operator++() noexcept { return fetch_add(1) + 1; }
    T operator++(int) noexcept { return fetch_add(1); }
    T operator--() noexcept { return fetch_sub(1) - 1; }
    T operator--(int) noexcept { return fetch_sub(1); }
    T operator+=(T v) noexcept { return fetch_add(v) + v; }
    T operator-=(T v) noexcept { return fetch_sub(v) - v; }
private:
    static constexpr size_t SIZE_ALIGNMENT = (sizeof(T) & (sizeof(T) - 1)) || sizeof(T) > 16 ? 0 : sizeof(T);
    alignas(SIZE_ALIGNMENT > alignof(T) ? SIZE_ALIGNMENT : alignof(T)) T value;
};
template <typename T> class atomic<T *> {
public:
    atomic() noexcept = default;
    constexpr atomic(T *initial) noexcept : value(initial) {}
    T *operator=(T *v) noexcept { store(v); return v; }
    operator T *() const noexcept { return load(); }
    void store(T *v, memory_order order = memory_order_seq_cst) noexcept { __atomic_store_n(&value, v, order); }
    T *load(memory_order order = memory_order_seq_cst) const noexcept { return __atomic_load_n(&value, order); }
    T *exchange(T *v, memory_order order = memory_order_seq_cst) noexcept { return __atomic_exchange_n(&value, v, order); }
    bool compare_exchange_strong(T *&expected, T *desired, memory_order order = memory_order_seq_cst) noexcept {
        return __atomic_compare_exchange_n(&value, &expected, desired, false, order, __ATOMIC_RELAXED);
    }
private:
    T *value;
};
typedef atomic<bool> atomic_bool;
typedef atomic<int> atomic_int;
typedef atomic<unsigned> atomic_uint;
typedef atomic<long> atomic_long;
typedef atomic<long long> atomic_llong;
typedef atomic<unsigned long> atomic_ulong;
inline void
atomic_thread_fence(memory_order order) noexcept { __atomic_thread_fence(order); }
}

#endif
