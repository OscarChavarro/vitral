#ifndef __SET__
#define __SET__
#include <bits/tree.h>
namespace std {
template <typename K> struct __set_key {
    const K &operator()(const K &value) const { return value; }
};
template <typename K, typename C = less<K> > class set {
    typedef __tree<K, K, __set_key<K>, C> Tree;
public:
    typedef K key_type;
    typedef K value_type;
    typedef C key_compare;
    typedef C value_compare;
    typedef size_t size_type;
    typedef ptrdiff_t difference_type;
    typedef const K &reference;
    typedef const K &const_reference;
    typedef typename Tree::const_iterator iterator;
    typedef typename Tree::const_iterator const_iterator;
    typedef std::reverse_iterator<iterator> reverse_iterator;
    typedef std::reverse_iterator<const_iterator> const_reverse_iterator;

    set() {}
    explicit set(const C &c) : tree(c) {}
    set(initializer_list<K> list) { insert(list.begin(), list.end()); }
    template <typename It> set(It from, It to) { insert(from, to); }

    iterator begin() const noexcept { return tree.begin(); }
    iterator end() const noexcept { return tree.end(); }
    iterator cbegin() const noexcept { return tree.begin(); }
    iterator cend() const noexcept { return tree.end(); }
    reverse_iterator rbegin() const noexcept { return reverse_iterator(end()); }
    reverse_iterator rend() const noexcept { return reverse_iterator(begin()); }

    bool empty() const noexcept { return tree.empty(); }
    size_type size() const noexcept { return tree.size(); }
    key_compare key_comp() const { return tree.key_comp(); }
    value_compare value_comp() const { return tree.key_comp(); }

    pair<iterator, bool> insert(const K &value) {
        pair<typename Tree::iterator, bool> r = tree.insert(value);
        return pair<iterator, bool>(r.first, r.second);
    }
    iterator insert(const_iterator, const K &value) { return tree.insert(value).first; }
    template <typename It>
    void insert(It from, It to) {
        for (; from != to; ++from) {
            tree.insert(*from);
        }
    }
    template <typename... A> pair<iterator, bool> emplace(A &&... arguments) {
        return insert(K(std::forward<A>(arguments)...));
    }

    iterator find(const K &key) const { return tree.find(key); }
    size_type count(const K &key) const { return tree.count(key); }
    iterator lower_bound(const K &key) const { return tree.lower_bound(key); }
    iterator upper_bound(const K &key) const { return tree.upper_bound(key); }

    iterator erase(const_iterator position) { return tree.erase(position); }
    iterator erase(const_iterator from, const_iterator to) { return tree.erase(from, to); }
    size_type erase(const K &key) { return tree.erase(key); }
    void clear() noexcept { tree.clear(); }
    void swap(set &other) noexcept { tree.swap(other.tree); }

private:
    Tree tree;
};
template <typename K, typename C>
bool
operator==(const set<K, C> &a, const set<K, C> &b) {
    if (a.size() != b.size()) {
        return false;
    }
    typename set<K, C>::const_iterator i = a.begin(), j = b.begin();
    for (; i != a.end(); ++i, ++j) {
        if (!(*i == *j)) {
            return false;
        }
    }
    return true;
}
template <typename K, typename C>
bool
operator!=(const set<K, C> &a, const set<K, C> &b) { return !(a == b); }
}

#endif
