#ifndef __MUTEX__
#define __MUTEX__
#include <pthread.h>
namespace std {
class mutex {
public:
    constexpr mutex() noexcept : handle{0, PTHREAD_MUTEX_NORMAL, 0, 0} {}
    mutex(const mutex &) = delete;
    mutex &operator=(const mutex &) = delete;
    void lock() { pthread_mutex_lock(&handle); }
    bool try_lock() { return pthread_mutex_trylock(&handle) == 0; }
    void unlock() { pthread_mutex_unlock(&handle); }
    pthread_mutex_t *native_handle() { return &handle; }
private:
    pthread_mutex_t handle;
};
class recursive_mutex {
public:
    constexpr recursive_mutex() noexcept : handle{0, PTHREAD_MUTEX_RECURSIVE, 0, 0} {}
    recursive_mutex(const recursive_mutex &) = delete;
    recursive_mutex &operator=(const recursive_mutex &) = delete;
    void lock() { pthread_mutex_lock(&handle); }
    bool try_lock() { return pthread_mutex_trylock(&handle) == 0; }
    void unlock() { pthread_mutex_unlock(&handle); }
    pthread_mutex_t *native_handle() { return &handle; }
private:
    pthread_mutex_t handle;
};
struct defer_lock_t { explicit defer_lock_t() = default; };
struct try_to_lock_t { explicit try_to_lock_t() = default; };
struct adopt_lock_t { explicit adopt_lock_t() = default; };
constexpr defer_lock_t defer_lock{};
constexpr try_to_lock_t try_to_lock{};
constexpr adopt_lock_t adopt_lock{};
template <typename M> class lock_guard {
public:
    typedef M mutex_type;
    explicit lock_guard(M &m) : held(m) { held.lock(); }
    lock_guard(M &m, adopt_lock_t) : held(m) {}
    ~lock_guard() { held.unlock(); }
    lock_guard(const lock_guard &) = delete;
    lock_guard &operator=(const lock_guard &) = delete;
private:
    M &held;
};
template <typename M> class unique_lock {
public:
    typedef M mutex_type;
    unique_lock() noexcept : held(nullptr), owns(false) {}
    explicit unique_lock(M &m) : held(&m), owns(false) { lock(); }
    unique_lock(M &m, defer_lock_t) noexcept : held(&m), owns(false) {}
    unique_lock(M &m, try_to_lock_t) : held(&m), owns(m.try_lock()) {}
    unique_lock(M &m, adopt_lock_t) : held(&m), owns(true) {}
    unique_lock(unique_lock &&other) noexcept : held(other.held), owns(other.owns) {
        other.held = nullptr;
        other.owns = false;
    }
    unique_lock &operator=(unique_lock &&other) noexcept {
        if (owns) {
            held->unlock();
        }
        held = other.held;
        owns = other.owns;
        other.held = nullptr;
        other.owns = false;
        return *this;
    }
    ~unique_lock() {
        if (owns) {
            held->unlock();
        }
    }
    unique_lock(const unique_lock &) = delete;
    unique_lock &operator=(const unique_lock &) = delete;
    void lock() {
        held->lock();
        owns = true;
    }
    bool try_lock() { return owns = held->try_lock(); }
    void unlock() {
        held->unlock();
        owns = false;
    }
    M *release() noexcept {
        M *m = held;
        held = nullptr;
        owns = false;
        return m;
    }
    M *mutex() const noexcept { return held; }
    bool owns_lock() const noexcept { return owns; }
    explicit operator bool() const noexcept { return owns; }
private:
    M *held;
    bool owns;
};
}

#endif
