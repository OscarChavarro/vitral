#ifndef __LIMITS__
#define __LIMITS__
#include <cfloat>
#include <climits>
namespace std {
enum float_round_style { round_toward_zero = 0, round_to_nearest = 1 };
template <typename T> class numeric_limits {
public:
    static constexpr bool is_specialized = false;
    static constexpr T min() noexcept { return T(); }
    static constexpr T max() noexcept { return T(); }
    static constexpr T lowest() noexcept { return T(); }
    static constexpr T epsilon() noexcept { return T(); }
    static constexpr T infinity() noexcept { return T(); }
    static constexpr T quiet_NaN() noexcept { return T(); }
};
#define VITRAL_INTEGER_LIMITS(type, low, high, bits, isSigned) \
    template <> class numeric_limits<type> { \
    public: \
        static constexpr bool is_specialized = true; \
        static constexpr bool is_signed = isSigned; \
        static constexpr bool is_integer = true; \
        static constexpr bool is_exact = true; \
        static constexpr bool has_infinity = false; \
        static constexpr bool has_quiet_NaN = false; \
        static constexpr int digits = bits; \
        static constexpr int radix = 2; \
        static constexpr type min() noexcept { return low; } \
        static constexpr type max() noexcept { return high; } \
        static constexpr type lowest() noexcept { return low; } \
        static constexpr type epsilon() noexcept { return 0; } \
        static constexpr type infinity() noexcept { return 0; } \
        static constexpr type quiet_NaN() noexcept { return 0; } \
    };
VITRAL_INTEGER_LIMITS(bool, false, true, 1, false)
VITRAL_INTEGER_LIMITS(char, CHAR_MIN, CHAR_MAX, 7, true)
VITRAL_INTEGER_LIMITS(signed char, SCHAR_MIN, SCHAR_MAX, 7, true)
VITRAL_INTEGER_LIMITS(unsigned char, 0, UCHAR_MAX, 8, false)
VITRAL_INTEGER_LIMITS(short, SHRT_MIN, SHRT_MAX, 15, true)
VITRAL_INTEGER_LIMITS(unsigned short, 0, USHRT_MAX, 16, false)
VITRAL_INTEGER_LIMITS(int, INT_MIN, INT_MAX, 31, true)
VITRAL_INTEGER_LIMITS(unsigned int, 0, UINT_MAX, 32, false)
VITRAL_INTEGER_LIMITS(long, LONG_MIN, LONG_MAX, 63, true)
VITRAL_INTEGER_LIMITS(unsigned long, 0, ULONG_MAX, 64, false)
VITRAL_INTEGER_LIMITS(long long, LLONG_MIN, LLONG_MAX, 63, true)
VITRAL_INTEGER_LIMITS(unsigned long long, 0, ULLONG_MAX, 64, false)
#undef VITRAL_INTEGER_LIMITS
#define VITRAL_FLOAT_LIMITS(type, prefix) \
    template <> class numeric_limits<type> { \
    public: \
        static constexpr bool is_specialized = true; \
        static constexpr bool is_signed = true; \
        static constexpr bool is_integer = false; \
        static constexpr bool is_exact = false; \
        static constexpr bool has_infinity = true; \
        static constexpr bool has_quiet_NaN = true; \
        static constexpr int digits = prefix##_MANT_DIG; \
        static constexpr int digits10 = prefix##_DIG; \
        static constexpr int radix = 2; \
        static constexpr int max_exponent = prefix##_MAX_EXP; \
        static constexpr int min_exponent = prefix##_MIN_EXP; \
        static constexpr type min() noexcept { return prefix##_MIN; } \
        static constexpr type max() noexcept { return prefix##_MAX; } \
        static constexpr type lowest() noexcept { return -prefix##_MAX; } \
        static constexpr type epsilon() noexcept { return prefix##_EPSILON; } \
        static constexpr type infinity() noexcept { return __builtin_inf(); } \
        static constexpr type quiet_NaN() noexcept { return __builtin_nan(""); } \
    };
VITRAL_FLOAT_LIMITS(float, FLT)
VITRAL_FLOAT_LIMITS(double, DBL)
VITRAL_FLOAT_LIMITS(long double, LDBL)
#undef VITRAL_FLOAT_LIMITS
}

#endif
