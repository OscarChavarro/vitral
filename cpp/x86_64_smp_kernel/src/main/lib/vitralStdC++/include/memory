__shared_ptr_unlock() noexcept;
template <typename T>
shared_ptr<T>
atomic_load(const shared_ptr<T> *p) {
    __shared_ptr_lock();
    shared_ptr<T> copy(*p);
    __shared_ptr_unlock();
    return copy;
}
template <typename T>
void
atomic_store(shared_ptr<T> *p, shared_ptr<T> value) {
    __shared_ptr_lock();
    p->swap(value);
    __shared_ptr_unlock();
}
template <typename T>
shared_ptr<T>
atomic_exchange(shared_ptr<T> *p, shared_ptr<T> value) {
    __shared_ptr_lock();
    p->swap(value);
    __shared_ptr_unlock();
