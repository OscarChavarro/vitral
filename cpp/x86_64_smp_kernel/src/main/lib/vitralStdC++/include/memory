}
struct __shared_count {
    long strong;
    long weak;
    virtual void destroy() = 0;
    virtual ~__shared_count() {}
};
template <typename T, typename D> struct __shared_count_impl : __shared_count {
    T *object;
    D deleter;
    __shared_count_impl(T *p, D d) : object(p), deleter(d) { strong = 1; weak = 0; }
    void destroy() override { deleter(object); }
};
template <typename T> class weak_ptr;
template <typename T> class shared_ptr {
public:
    typedef T element_type;
    shared_ptr() noexcept : object(nullptr), control(nullptr) {}
    shared_ptr(nullptr_t) noexcept : object(nullptr), control(nullptr) {}
    explicit shared_ptr(T *p) : object(p), control(nullptr) {
        if (p) {
            control = new __shared_count_impl<T, default_delete<T>>(p, default_delete<T>());
        }
    }
    template <typename D>
    shared_ptr(T *p, D deleter) : object(p), control(nullptr) {
        if (p) {
            control = new __shared_count_impl<T, D>(p, deleter);
        }
    }
    shared_ptr(const shared_ptr &other) noexcept : object(other.object), control(other.control) { acquire(); }
    template <typename U> shared_ptr(const shared_ptr<U> &other) noexcept
        : object(other.object), control(other.control) { acquire(); }
    shared_ptr(shared_ptr &&other) noexcept : object(other.object), control(other.control) {
        other.object = nullptr;
        other.control = nullptr;
    }
    ~shared_ptr() { drop(); }
    shared_ptr &operator=(const shared_ptr &other) noexcept {
        shared_ptr(other).swap(*this);
        return *this;
    }
    shared_ptr &operator=(shared_ptr &&other) noexcept {
        shared_ptr(std::move(other)).swap(*this);
        return *this;
    }
    void swap(shared_ptr &other) noexcept {
        std::swap(object, other.object);
        std::swap(control, other.control);
    }
    void reset() noexcept { shared_ptr().swap(*this); }
    void reset(T *p) { shared_ptr(p).swap(*this); }
    T *get() const noexcept { return object; }
    T &operator*() const noexcept { return *object; }
    T *operator->() const noexcept { return object; }
    long use_count() const noexcept { return control ? control->strong : 0; }
    explicit operator bool() const noexcept { return object != nullptr; }
private:
    template <typename U> friend class shared_ptr;
    T *object;
    __shared_count *control;
    void acquire() {
        if (control) {
            __atomic_add_fetch(&control->strong, 1, __ATOMIC_SEQ_CST);
        }
    }
    void drop() {
        if (control && __atomic_sub_fetch(&control->strong, 1, __ATOMIC_SEQ_CST) == 0) {
            control->destroy();
            delete control;
        }
        object = nullptr;
        control = nullptr;
    }
};
template <typename T, typename U>
bool
operator==(const shared_ptr<T> &a, const shared_ptr<U> &b) noexcept {
    return a.get() == b.get();
}
template <typename T, typename U>
bool
operator!=(const shared_ptr<T> &a, const shared_ptr<U> &b) noexcept {
    return a.get() != b.get();
}
