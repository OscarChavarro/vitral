template <typename T> struct default_delete {
    void operator()(T *p) const { delete p; }
};
template <typename T> struct default_delete<T[]> {
    void operator()(T *p) const { delete[] p; }
};
template <typename T, typename D = default_delete<T> > class unique_ptr {
public:
    typedef T element_type;
    typedef T *pointer;
    unique_ptr() noexcept : held(nullptr) {}
    unique_ptr(nullptr_t) noexcept : held(nullptr) {}
    explicit unique_ptr(T *p) noexcept : held(p) {}
    unique_ptr(unique_ptr &&other) noexcept : held(other.release()) {}
    template <typename U> unique_ptr(unique_ptr<U> &&other) noexcept : held(other.release()) {}
    ~unique_ptr() { reset(); }
    unique_ptr &operator=(unique_ptr &&other) noexcept {
        reset(other.release());
        return *this;
    }
    unique_ptr &operator=(nullptr_t) noexcept {
        reset();
        return *this;
    }
    T *get() const noexcept { return held; }
    T *release() noexcept {
        T *p = held;
        held = nullptr;
        return p;
    }
    void reset(T *p = nullptr) noexcept {
        T *old = held;
        held = p;
        if (old) {
            D()(old);
        }
    }
    T &operator*() const { return *held; }
    T *operator->() const noexcept { return held; }
    explicit operator bool() const noexcept { return held != nullptr; }
    unique_ptr(const unique_ptr &) = delete;
    unique_ptr &operator=(const unique_ptr &) = delete;
private:
    T *held;
};
template <typename T> class unique_ptr<T[], default_delete<T[]> > {
public:
    unique_ptr() noexcept : held(nullptr) {}
    explicit unique_ptr(T *p) noexcept : held(p) {}
    unique_ptr(unique_ptr &&other) noexcept : held(other.release()) {}
    ~unique_ptr() { reset(); }
    unique_ptr &operator=(unique_ptr &&other) noexcept {
        reset(other.release());
        return *this;
    }
    T *get() const noexcept { return held; }
    T *release() noexcept {
        T *p = held;
        held = nullptr;
        return p;
    }
    void reset(T *p = nullptr) noexcept {
        T *old = held;
        held = p;
        delete[] old;
    }
    T &operator[](size_t i) const { return held[i]; }
    explicit operator bool() const noexcept { return held != nullptr; }
    unique_ptr(const unique_ptr &) = delete;
    unique_ptr &operator=(const unique_ptr &) = delete;
private:
    T *held;
};
template <typename T, typename... A>
