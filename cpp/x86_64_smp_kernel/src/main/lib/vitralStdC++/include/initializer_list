#ifndef __INITIALIZER_LIST__
#define __INITIALIZER_LIST__
#include <cstddef>
namespace std {
template <typename T> class initializer_list {
public:
    typedef T value_type;
    typedef const T &reference;
    typedef const T &const_reference;
    typedef size_t size_type;
    typedef const T *iterator;
    typedef const T *const_iterator;
    constexpr initializer_list() noexcept : first(nullptr), count(0) {}
    constexpr size_t size() const noexcept { return count; }
    constexpr const T *begin() const noexcept { return first; }
    constexpr const T *end() const noexcept { return first + count; }
private:
    const T *first;
    size_t count;
    constexpr initializer_list(const T *f, size_t c) : first(f), count(c) {}
};
template <typename T>
constexpr const T *
begin(initializer_list<T> list) noexcept { return list.begin(); }
template <typename T>
constexpr const T *
end(initializer_list<T> list) noexcept { return list.end(); }
}

#endif
