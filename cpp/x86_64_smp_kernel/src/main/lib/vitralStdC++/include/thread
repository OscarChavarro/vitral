#ifndef __VITRAL_STDCXX_THREAD__
#define __VITRAL_STDCXX_THREAD__
#include <chrono>
#include <pthread.h>
#include <utility>
#include <type_traits>
namespace std {
struct __thread_task {
    virtual void run() = 0;
    virtual ~__thread_task() {}
};
template <typename F> struct __thread_function : __thread_task {
    F function;
    explicit __thread_function(F &&f) : function(std::move(f)) {}
    explicit __thread_function(const F &f) : function(f) {}
    void run() override { function(); }
};
class thread {
public:
    class id {
    public:
        id() noexcept : handle(0) {}
        explicit id(pthread_t h) noexcept : handle(h) {}
        bool operator==(const id &other) const noexcept { return handle == other.handle; }
        bool operator!=(const id &other) const noexcept { return handle != other.handle; }
        bool operator<(const id &other) const noexcept { return handle < other.handle; }
    private:
        pthread_t handle;
    };
    typedef pthread_t native_handle_type;
    thread() noexcept : handle(0) {}
    template <typename F> explicit thread(F &&f) : handle(0) {
        __start(new __thread_function<typename decay<F>::type>(std::forward<F>(f)));
    }
    thread(thread &&other) noexcept : handle(other.handle) { other.handle = 0; }
    thread &operator=(thread &&other) noexcept;
    ~thread();
    thread(const thread &) = delete;
    thread &operator=(const thread &) = delete;
    bool joinable() const noexcept { return handle != 0; }
    id get_id() const noexcept { return id(handle); }
    native_handle_type native_handle() { return handle; }
    void join();
    void detach();
    void swap(thread &other) noexcept { std::swap(handle, other.handle); }
    static unsigned hardware_concurrency() noexcept;
private:
    pthread_t handle;
    void __start(__thread_task *task);
};
inline void
swap(thread &a, thread &b) noexcept { a.swap(b); }
namespace this_thread {
inline thread::id
get_id() noexcept { return thread::id(pthread_self()); }
void
yield() noexcept;
void
__sleep(long long nanoseconds);
template <typename Rep, typename Period>
void
sleep_for(const chrono::duration<Rep, Period> &d) {
    __sleep(chrono::duration_cast<chrono::nanoseconds>(d).count());
}
template <typename Clock, typename Duration>
void
sleep_until(const chrono::time_point<Clock, Duration> &t) {
    sleep_for(t - Clock::now());
}
}
}

#endif
