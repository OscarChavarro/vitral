#ifndef __SSTREAM__
#define __SSTREAM__
#include <string>
namespace std {
class ostringstream {
public:
    ostringstream() {}
    explicit ostringstream(const string &initial) : buffer(initial) {}
    string str() const { return buffer; }
    void str(const string &s) { buffer = s; }
    ostringstream &operator<<(const char *s) {
        buffer += s ? s : "(null)";
        return *this;
    }
    ostringstream &operator<<(const string &s) {
        buffer += s;
        return *this;
    }
    ostringstream &operator<<(char c) {
        buffer += c;
        return *this;
    }
    ostringstream &operator<<(bool value) { return *this << (value ? "1" : "0"); }
    ostringstream &operator<<(int value) { return *this << to_string(value); }
    ostringstream &operator<<(long value) { return *this << to_string(value); }
    ostringstream &operator<<(long long value) { return *this << to_string(value); }
    ostringstream &operator<<(unsigned value) { return *this << to_string(value); }
    ostringstream &operator<<(unsigned long value) { return *this << to_string(value); }
    ostringstream &operator<<(unsigned long long value) { return *this << to_string(value); }
    ostringstream &operator<<(double value);
    ostringstream &operator<<(float value) { return *this << (double)value; }
    ostringstream &operator<<(const void *p);
private:
    string buffer;
};
}

#endif
