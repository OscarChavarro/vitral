template <class CharT>
struct char_traits;

template <>
struct char_traits<char> {
    static size_t length(const char *text) { return strlen(text); }
};

class string {
public:
    typedef char value_type;
    typedef size_t size_type;
    typedef ptrdiff_t difference_type;
    typedef char &reference;
    typedef const char &const_reference;
    typedef char *pointer;
    typedef const char *const_pointer;
    typedef char *iterator;
    typedef const char *const_iterator;
    static const size_type npos = (size_type)-1;

    string() : text(nothing()), count(0), room(0) {}
    string(const char *s) : text(nothing()), count(0), room(0) { assign(s, strlen(s)); }
    string(const char *s, size_type n) : text(nothing()), count(0), room(0) { assign(s, n); }
    string(size_type n, char c) : text(nothing()), count(0), room(0) { assign(n, c); }
    string(const string &other) : text(nothing()), count(0), room(0) { assign(other.text, other.count); }
    string(const string &other, size_type pos, size_type n = npos) : text(nothing()), count(0), room(0) {
        assign(other.text + pos, clip(other, pos, n));
    }
    string(string &&other) noexcept : text(other.text), count(other.count), room(other.room) {
        other.text = nothing();
        other.count = other.room = 0;
    }
    template <typename It>
    string(It from, It to) : text(nothing()), count(0), room(0) {
        for (; from != to; ++from) {
            push_back(*from);
        }
    }
    string(initializer_list<char> list) : text(nothing()), count(0), room(0) { assign(list.begin(), list.size()); }
    ~string() { release(); }

    string &operator=(const string &other) { return other.text == text ? *this : assign(other.text, other.count); }
    string &operator=(string &&other) noexcept {
        if (this != &other) {
            release();
            text = other.text;
            count = other.count;
            room = other.room;
            other.text = nothing();
            other.count = other.room = 0;
        }
        return *this;
    }
    string &operator=(const char *s) { return assign(s, strlen(s)); }
    string &operator=(char c) { return assign(&c, 1); }

    string &assign(const char *s, size_type n) {
        count = 0;
        return append(s, n);
    }
    string &assign(const char *s) { return assign(s, strlen(s)); }
    string &assign(const string &other) { return *this = other; }
    string &assign(size_type n, char c) {
        count = 0;
        return append(n, c);
    }

    string &append(const char *s, size_type n) {
        if (n == 0) {
            return *this;
        }
        if (s >= text && s < text + count) {
            string copy(s, n);
            return append(copy.text, copy.count);
        }
        reserve(count + n);
        memcpy(text + count, s, n);
        count += n;
        text[count] = 0;
        return *this;
    }
    string &append(const char *s) { return append(s, strlen(s)); }
    string &append(const string &other) { return append(other.text, other.count); }
    string &append(const string &other, size_type pos, size_type n = npos) {
        return append(other.text + pos, clip(other, pos, n));
    }
    string &append(size_type n, char c) {
        if (n == 0) {
            return *this;
        }
        reserve(count + n);
        memset(text + count, c, n);
        count += n;
        text[count] = 0;
        return *this;
    }
    string &operator+=(const string &other) { return append(other); }
    string &operator+=(const char *s) { return append(s); }
    string &operator+=(char c) {
        push_back(c);
        return *this;
    }
    void push_back(char c) { append(&c, 1); }
    void pop_back() { text[--count] = 0; }

    const char *c_str() const noexcept { return text; }
    const char *data() const noexcept { return text; }
    char *data() noexcept { return text; }
    size_type size() const noexcept { return count; }
    size_type length() const noexcept { return count; }
    size_type capacity() const noexcept { return room; }
    size_type max_size() const noexcept { return npos - 1; }
    bool empty() const noexcept { return count == 0; }
    void clear() noexcept {
        count = 0;
        if (room) {
            text[0] = 0;
        }
    }
    void reserve(size_type n) {
        if (n <= room) {
            return;
        }
        size_type grown = room * 2 > n ? room * 2 : n;
        char *bigger = (char *)::operator new(grown + 1);
        memcpy(bigger, text, count + 1);
        release();
        text = bigger;
        room = grown;
    }
    void resize(size_type n, char c = 0) {
        if (n > count) {
            append(n - count, c);
        } else if (room) {
            text[count = n] = 0;
        }
    }

    char &operator[](size_type i) { return text[i]; }
    const char &operator[](size_type i) const { return text[i]; }
    char &at(size_type i) { return text[i]; }
    const char &at(size_type i) const { return text[i]; }
    char &front() { return text[0]; }
    const char &front() const { return text[0]; }
    char &back() { return text[count - 1]; }
    const char &back() const { return text[count - 1]; }
    iterator begin() noexcept { return text; }
    iterator end() noexcept { return text + count; }
    const_iterator begin() const noexcept { return text; }
    const_iterator end() const noexcept { return text + count; }
    const_iterator cbegin() const noexcept { return text; }
    const_iterator cend() const noexcept { return text + count; }

    string substr(size_type pos = 0, size_type n = npos) const { return string(*this, pos, n); }
    string &erase(size_type pos = 0, size_type n = npos) {
        n = clip(*this, pos, n);
        memmove(text + pos, text + pos + n, count - pos - n + 1);
        count -= n;
        return *this;
    }
    string &insert(size_type pos, const char *s, size_type n) {
        string tail(*this, pos);
        resize(pos);
        return append(s, n).append(tail);
    }
    string &insert(size_type pos, const char *s) { return insert(pos, s, strlen(s)); }
    string &insert(size_type pos, const string &other) { return insert(pos, other.text, other.count); }
    string &replace(size_type pos, size_type n, const char *s, size_type sn) {
        string tail(*this, pos + clip(*this, pos, n));
        resize(pos);
        return append(s, sn).append(tail);
    }
    string &replace(size_type pos, size_type n, const string &other) {
        return replace(pos, n, other.text, other.count);
    }
    string &replace(size_type pos, size_type n, const char *s) { return replace(pos, n, s, strlen(s)); }

    size_type find(const char *s, size_type pos, size_type n) const {
        if (n == 0) {
            return pos <= count ? pos : npos;
        }
        for (; pos + n <= count; pos++) {
            if (memcmp(text + pos, s, n) == 0) {
                return pos;
            }
        }
        return npos;
    }
    size_type find(const char *s, size_type pos = 0) const { return find(s, pos, strlen(s)); }
    size_type find(const string &other, size_type pos = 0) const { return find(other.text, pos, other.count); }
    size_type find(char c, size_type pos = 0) const {
        for (; pos < count; pos++) {
            if (text[pos] == c) {
                return pos;
            }
        }
        return npos;
    }
    size_type rfind(const char *s, size_type pos, size_type n) const {
        if (n > count) {
            return npos;
        }
        size_type i = count - n < pos ? count - n : pos;
        for (;; i--) {
            if (memcmp(text + i, s, n) == 0) {
                return i;
            }
            if (i == 0) {
                return npos;
            }
        }
    }
    size_type rfind(const char *s, size_type pos = npos) const { return rfind(s, pos, strlen(s)); }
    size_type rfind(const string &other, size_type pos = npos) const { return rfind(other.text, pos, other.count); }
    size_type rfind(char c, size_type pos = npos) const { return rfind(&c, pos, 1); }
    size_type find_first_of(const char *s, size_type pos = 0) const {
        for (; pos < count; pos++) {
            if (strchr(s, text[pos]) && text[pos]) {
                return pos;
            }
        }
        return npos;
    }
    size_type find_first_of(const string &other, size_type pos = 0) const { return find_first_of(other.text, pos); }
    size_type find_first_of(char c, size_type pos = 0) const { return find(c, pos); }
    size_type find_last_of(const char *s, size_type pos = npos) const {
        for (size_type i = count < pos + 1 ? count : pos + 1; i > 0; i--) {
            if (strchr(s, text[i - 1]) && text[i - 1]) {
                return i - 1;
            }
        }
        return npos;
    }
    size_type find_last_of(const string &other, size_type pos = npos) const { return find_last_of(other.text, pos); }
    size_type find_last_of(char c, size_type pos = npos) const { return rfind(c, pos); }
    size_type find_first_not_of(const char *s, size_type pos = 0) const {
        for (; pos < count; pos++) {
            if (!strchr(s, text[pos]) || !text[pos]) {
                return pos;
            }
        }
        return npos;
    }
    size_type find_first_not_of(const string &other, size_type pos = 0) const {
        return find_first_not_of(other.text, pos);
    }
    size_type find_last_not_of(const char *s, size_type pos = npos) const {
        for (size_type i = count < pos + 1 ? count : pos + 1; i > 0; i--) {
            if (!strchr(s, text[i - 1]) || !text[i - 1]) {
                return i - 1;
            }
        }
        return npos;
    }
    size_type find_last_not_of(const string &other, size_type pos = npos) const {
        return find_last_not_of(other.text, pos);
    }

    int compare(const char *s, size_type n) const {
        int r = memcmp(text, s, count < n ? count : n);
        return r != 0 ? r : count < n ? -1 : count > n ? 1 : 0;
    }
    int compare(const string &other) const { return compare(other.text, other.count); }
    int compare(const char *s) const { return compare(s, strlen(s)); }
    int compare(size_type pos, size_type n, const string &other) const { return substr(pos, n).compare(other); }
    int compare(size_type pos, size_type n, const char *s) const { return substr(pos, n).compare(s); }
    void swap(string &other) noexcept {
        std::swap(text, other.text);
        std::swap(count, other.count);
        std::swap(room, other.room);
    }

private:
    char *text;
    size_type count;
    size_type room;
    static char *nothing() { return const_cast<char *>(""); }
    static size_type clip(const string &s, size_type pos, size_type n) {
        return n > s.count - pos ? s.count - pos : n;
    }
    void release() {
        if (room) {
            ::operator delete(text);
        }
        text = nothing();
        room = 0;
    }
};
inline string
operator+(const string &a, const string &b) {
    string r(a);
    return r += b;
}
inline string
operator+(const string &a, const char *b) {
    string r(a);
    return r += b;
}
inline string
operator+(const char *a, const string &b) {
    string r(a);
    return r += b;
}
inline string
operator+(const string &a, char b) {
    string r(a);
    return r += b;
}
inline string
operator+(char a, const string &b) {
    string r(1, a);
    return r += b;
}
inline string
operator+(string &&a, const string &b) { return std::move(a += b); }
inline string
operator+(string &&a, const char *b) { return std::move(a += b); }
inline string
operator+(string &&a, char b) { return std::move(a += b); }
inline bool
operator==(const string &a, const string &b) { return a.compare(b) == 0; }
inline bool
operator==(const string &a, const char *b) { return a.compare(b) == 0; }
inline bool
operator==(const char *a, const string &b) { return b.compare(a) == 0; }
inline bool
operator!=(const string &a, const string &b) { return a.compare(b) != 0; }
inline bool
operator!=(const string &a, const char *b) { return a.compare(b) != 0; }
inline bool
operator!=(const char *a, const string &b) { return b.compare(a) != 0; }
inline bool
operator<(const string &a, const string &b) { return a.compare(b) < 0; }
inline bool
operator<(const string &a, const char *b) { return a.compare(b) < 0; }
inline bool
operator<(const char *a, const string &b) { return b.compare(a) > 0; }
inline bool
operator>(const string &a, const string &b) { return a.compare(b) > 0; }
inline bool
operator<=(const string &a, const string &b) { return a.compare(b) <= 0; }
inline bool
operator>=(const string &a, const string &b) { return a.compare(b) >= 0; }
