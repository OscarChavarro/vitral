#ifndef __VECTOR__
#define __VECTOR__
#include <cstddef>
#include <cstring>
#include <new>
#include <utility>
#include <iterator>
#include <initializer_list>
#include <stdexcept>
namespace std {
template <typename T> class vector {
public:
    typedef T value_type;
    typedef T *iterator;
    typedef const T *const_iterator;
    typedef T &reference;
    typedef const T &const_reference;
    typedef size_t size_type;
    typedef ptrdiff_t difference_type;
    typedef T *pointer;
    typedef const T *const_pointer;
    typedef reverse_iterator<iterator> reverse_iterator;
    typedef std::reverse_iterator<const_iterator> const_reverse_iterator;

    vector() : first(nullptr), count(0), room(0) {}
    explicit vector(size_t n) : first(nullptr), count(0), room(0) { resize(n); }
    vector(size_t n, const T &value) : first(nullptr), count(0), room(0) { resize(n, value); }
    vector(initializer_list<T> list) : first(nullptr), count(0), room(0) {
        reserve(list.size());
        for (const T *p = list.begin(); p != list.end(); ++p) {
            push_back(*p);
        }
    }
    template <typename It> vector(It from, It to, typename enable_if<!is_integral<It>::value>::type * = 0)
        : first(nullptr), count(0), room(0) {
        for (; from != to; ++from) {
            push_back(*from);
        }
    }
    vector(const vector &other) : first(nullptr), count(0), room(0) {
        reserve(other.count);
        for (size_t i = 0; i < other.count; i++) {
            new (first + i) T(other.first[i]);
        }
        count = other.count;
    }
    vector(vector &&other) noexcept : first(other.first), count(other.count), room(other.room) {
        other.first = nullptr;
        other.count = other.room = 0;
    }
    ~vector() { release(); }
    vector &operator=(const vector &other) {
        if (this != &other) {
            clear();
            reserve(other.count);
            for (size_t i = 0; i < other.count; i++) {
                new (first + i) T(other.first[i]);
            }
            count = other.count;
        }
        return *this;
    }
    vector &operator=(vector &&other) noexcept {
        if (this != &other) {
            release();
            first = other.first;
            count = other.count;
            room = other.room;
            other.first = nullptr;
            other.count = other.room = 0;
        }
        return *this;
    }
    size_t size() const { return count; }
    size_t capacity() const { return room; }
    bool empty() const { return count == 0; }
    size_t max_size() const { return (size_t)-1 / sizeof(T); }
    T *data() { return first; }
    const T *data() const { return first; }
    T &operator[](size_t i) { return first[i]; }
    const T &operator[](size_t i) const { return first[i]; }
    T &at(size_t i) {
        if (i >= count) {
            throw out_of_range("vector::at");
        }
        return first[i];
    }
    const T &at(size_t i) const {
        if (i >= count) {
            throw out_of_range("vector::at");
        }
        return first[i];
    }
    T &front() { return first[0]; }
    const T &front() const { return first[0]; }
    T &back() { return first[count - 1]; }
    const T &back() const { return first[count - 1]; }
    iterator begin() { return first; }
    iterator end() { return first + count; }
    const_iterator begin() const { return first; }
    const_iterator end() const { return first + count; }
    const_iterator cbegin() const { return first; }
    const_iterator cend() const { return first + count; }
    reverse_iterator rbegin() { return reverse_iterator(end()); }
    reverse_iterator rend() { return reverse_iterator(begin()); }
    const_reverse_iterator rbegin() const { return const_reverse_iterator(end()); }
    const_reverse_iterator rend() const { return const_reverse_iterator(begin()); }
    void reserve(size_t n) {
        if (n <= room) {
            return;
        }
        T *grown = (T *)::operator new(n * sizeof(T));
        for (size_t i = 0; i < count; i++) {
            new (grown + i) T(std::move(first[i]));
            first[i].~T();
        }
        ::operator delete(first);
        first = grown;
        room = n;
    }
    void shrink_to_fit() {}
    void push_back(const T &value) {
        if (count == room) {
            T copy(value);
            reserve(room ? room * 2 : 4);
            new (first + count) T(std::move(copy));
        } else {
            new (first + count) T(value);
        }
        count++;
    }
    void push_back(T &&value) {
        if (count == room) {
            T copy(std::move(value));
            reserve(room ? room * 2 : 4);
            new (first + count) T(std::move(copy));
        } else {
            new (first + count) T(std::move(value));
        }
        count++;
    }
    template <typename... A>
    void emplace_back(A &&...arguments) {
        if (count == room) {
            reserve(room ? room * 2 : 4);
        }
        new (first + count) T(forward<A>(arguments)...);
        count++;
    }
    void pop_back() { first[--count].~T(); }
    void clear() {
        for (size_t i = 0; i < count; i++) {
            first[i].~T();
        }
        count = 0;
    }
    void resize(size_t n) {
        if (n < count) {
            for (size_t i = n; i < count; i++) {
                first[i].~T();
            }
        } else {
            reserve(n);
            for (size_t i = count; i < n; i++) {
                new (first + i) T();
            }
        }
        count = n;
    }
    void resize(size_t n, const T &value) {
        if (n < count) {
            for (size_t i = n; i < count; i++) {
                first[i].~T();
            }
        } else {
            reserve(n);
            for (size_t i = count; i < n; i++) {
                new (first + i) T(value);
            }
        }
        count = n;
    }
    void assign(size_t n, const T &value) {
        clear();
        resize(n, value);
    }
    iterator insert(const_iterator where, const T &value) {
        size_t index = where - first;
        T copy(value);
        push_back(T());
        for (size_t i = count - 1; i > index; i--) {
            first[i] = std::move(first[i - 1]);
        }
        first[index] = std::move(copy);
        return first + index;
    }
    template <typename It> iterator insert(const_iterator where, It from, It to) {
        size_t index = where - first;
        size_t at = index;
        for (; from != to; ++from, ++at) {
            insert(first + at, *from);
        }
        return first + index;
    }
    iterator erase(const_iterator where) {
        size_t index = where - first;
        for (size_t i = index; i + 1 < count; i++) {
            first[i] = std::move(first[i + 1]);
        }
        first[--count].~T();
        return first + index;
    }
    iterator erase(const_iterator from, const_iterator to) {
        size_t a = from - first;
        size_t b = to - first;
        if (a == b) {
            return first + a;
        }
        for (size_t i = b; i < count; i++) {
            first[a + i - b] = std::move(first[i]);
        }
        size_t removed = b - a;
        for (size_t i = count - removed; i < count; i++) {
            first[i].~T();
        }
        count -= removed;
        return first + a;
    }
    void swap(vector &other) {
        std::swap(first, other.first);
        std::swap(count, other.count);
        std::swap(room, other.room);
    }
private:
    T *first;
    size_t count;
    size_t room;
    void release() {
        clear();
        ::operator delete(first);
        first = nullptr;
        room = 0;
    }
};
}

#endif
