template <typename It>
bool
is_sorted(It first, It last) {
    if (first == last) {
        return true;
    }
    for (It next = first; ++next != last; first = next) {
        if (*next < *first) {
            return false;
        }
    }
    return true;
}
template <typename It, typename Less>
void
__insertion_sort(It first, It last, Less less) {
    for (It i = first; i != last; ++i) {
        typename iterator_traits<It>::value_type value(std::move(*i));
        It j = i;
        while (j != first) {
            It prev = j;
            --prev;
            if (!less(value, *prev)) {
                break;
            }
            *j = std::move(*prev);
            j = prev;
        }
        *j = std::move(value);
    }
}
template <typename It, typename Less>
void
__sift_down(It first, ptrdiff_t start, ptrdiff_t size, Less less) {
    for (;;) {
        ptrdiff_t child = 2 * start + 1;
        if (child >= size) {
            return;
        }
        if (child + 1 < size && less(first[child], first[child + 1])) {
            child++;
        }
        if (!less(first[start], first[child])) {
            return;
        }
        swap(first[start], first[child]);
        start = child;
    }
}
template <typename It, typename Less>
void
__heap_sort(It first, It last, Less less) {
    ptrdiff_t size = last - first;
    for (ptrdiff_t i = size / 2 - 1; i >= 0; i--) {
        __sift_down(first, i, size, less);
    }
    for (ptrdiff_t end = size - 1; end > 0; end--) {
        swap(first[0], first[end]);
        __sift_down(first, 0, end, less);
    }
}
template <typename It, typename Less>
void
__intro_sort(It first, It last, int depth, Less less) {
    while (last - first > 16) {
        if (depth-- == 0) { __heap_sort(first, last, less); return; }
        It mid = first + (last - first) / 2;
        It tail = last - 1;
        if (less(*mid, *first)) {
            swap(*mid, *first);
        }
        if (less(*tail, *mid)) {
            swap(*tail, *mid);
            if (less(*mid, *first)) {
                swap(*mid, *first);
            }
        }
        typename iterator_traits<It>::value_type pivot(*mid);
        It i = first;
        It j = tail;
        for (;;) {
            while (less(*i, pivot)) {
                ++i;
            }
            while (less(pivot, *j)) {
                --j;
            }
            if (i >= j) {
                break;
            }
            swap(*i, *j);
            ++i;
            --j;
        }
        It cut = j + 1;
        if (cut - first < last - cut) {
            __intro_sort(first, cut, depth, less);
            first = cut;
        } else {
            __intro_sort(cut, last, depth, less);
            last = cut;
        }
    }
    __insertion_sort(first, last, less);
}
template <typename T> struct __less {
    bool operator()(const T &a, const T &b) const { return a < b; }
};
template <typename It, typename Less>
void
sort(It first, It last, Less less) {
    int depth = 0;
    for (ptrdiff_t n = last - first; n > 1; n >>= 1) {
        depth += 2;
    }
    __intro_sort(first, last, depth, less);
}
template <typename It>
void
sort(It first, It last) {
    sort(first, last, __less<typename iterator_traits<It>::value_type>());
}
template <typename It, typename Less>
void
stable_sort(It first, It last, Less less) {
    __insertion_sort(first, last, less);
}
template <typename It>
void
stable_sort(It first, It last) {
    stable_sort(first, last, __less<typename iterator_traits<It>::value_type>());
