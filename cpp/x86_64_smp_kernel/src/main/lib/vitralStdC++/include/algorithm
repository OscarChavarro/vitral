template <typename It, typename T>
It
lower_bound(It first, It last, const T &value) {
    typename iterator_traits<It>::difference_type n = distance(first, last);
    while (n > 0) {
        typename iterator_traits<It>::difference_type half = n / 2;
        It mid = first;
        advance(mid, half);
        if (*mid < value) {
            first = ++mid;
            n -= half + 1;
        } else {
            n = half;
        }
    }
    return first;
}
template <typename It, typename T>
It
upper_bound(It first, It last, const T &value) {
    typename iterator_traits<It>::difference_type n = distance(first, last);
    while (n > 0) {
        typename iterator_traits<It>::difference_type half = n / 2;
        It mid = first;
        advance(mid, half);
        if (!(value < *mid)) {
            first = ++mid;
            n -= half + 1;
        } else {
            n = half;
        }
    }
    return first;
}
